# FinSage AI Backend - Environment Variables

# Environment
ENVIRONMENT=production
DEBUG=false

# Security
JWT_SECRET=your-super-secret-key-change-this-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=30

# CORS
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional Services (gracefully degraded if not provided)
REDIS_URL=
POSTGRES_URL=
OLLAMA_BASE_URL=

# Logging
LOG_LEVEL=info
